# Keep lab services isolated from ZJUers Simulator.
COMPOSE_PROJECT_NAME=simulator_framework_lab
SIMULATOR_THEME=zju

# Suggested local ports if the lab later grows a Compose setup.
BACKEND_PORT=18000
FRONTEND_PORT=15173
DOCS_PORT=15174

# Suggested isolated database names.
POSTGRES_DB=simulator_framework_lab
POSTGRES_USER=simulator
POSTGRES_PASSWORD=change_me_in_local_env
REDIS_URL=redis://redis:6379/0

# Browser storage prefix to avoid leaking ZJU login or save state into the lab.
FRONTEND_STORAGE_PREFIX=simlab


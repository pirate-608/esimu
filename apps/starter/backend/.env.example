SIMULATOR_THEME=demo-campus
ESIMU_CONTENT_MODE=library
ESIMU_HYBRID_AI_PROBABILITY=0.35

# General OpenAI-compatible content model (optional).
ESIMU_LLM_PROVIDER=openai
ESIMU_LLM_MODEL=gpt-4o-mini
ESIMU_LLM_API_KEY=
ESIMU_LLM_BASE_URL=
ESIMU_LLM_TIMEOUT_SECONDS=20

# Optional MiniMax M2-her role-play model for messenger conversations.
ESIMU_RP_PROVIDER=minimax
ESIMU_RP_MODEL=M2-her
ESIMU_RP_API_KEY=
ESIMU_RP_BASE_URL=https://api.minimaxi.com/v1
